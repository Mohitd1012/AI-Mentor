{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Mentor",
  "version": "0.1.0",
  "identifier": "com.dewani.ai-mentor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Mentor",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "maxWidth": 1200,
        "maxHeight": 1400,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": false,
        "x": 1400,
        "y": 80
      },
      {
        "label": "overlay",
        "url": "index.html#overlay",
        "title": "AI Mentor — Overlay",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "acceptFirstMouse": false,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:8765 http://localhost:8765; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
