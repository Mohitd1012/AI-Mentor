# AI Mentor — backend environment config
# Copy to .env and fill in values you need.
# All cloud keys are optional — Ollama is the default.

# Server
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=info

# Ollama (local — default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b

# Privacy mode: local | hybrid | cloud
PRIVACY_MODE=local

# --- Optional cloud providers ---
# OPENAI_API_KEY=sk-...
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-20241022
